# ===== Auth / Session =====
# ใช้เซ็น JWT ของ session (jose). ต้องเปลี่ยนเป็นค่าสุ่มยาวๆ ก่อนขึ้น production เสมอ
# สร้างได้ง่ายๆ ด้วยคำสั่ง: openssl rand -base64 32
SESSION_SECRET=change-me-before-production

# ===== หน้า "รหัสผ่าน" (/passwords) — กุญแจเข้ารหัส =====
# ข้อมูลในหน้านี้ (ชื่อระบบ ชื่อผู้ใช้ รหัสผ่าน ฯลฯ) ถูกเข้ารหัส AES-256-GCM ด้วยกุญแจนี้ก่อนลงไฟล์
# เพราะ backup.bat คัดลอก data/ เข้า backups/ ซึ่งอยู่ใน git — ไม่มีกุญแจ ไฟล์ใน backup/git เปิดอ่านไม่ได้
# ว่าง/ผิดรูปแบบ = หน้ารหัสผ่านใช้ไม่ได้ (หน้าอื่นทำงานปกติ) · ไม่มีค่าสำรองในโค้ดโดยตั้งใจ
# สร้าง (รันในโฟลเดอร์โปรเจกต์): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ เก็บสำเนากุญแจไว้นอกเครื่องนี้ (เช่นพิมพ์ใส่ซองเก็บตู้เซฟ) — กุญแจหาย = รหัสทั้งหมดในหน้านี้เปิดไม่ได้อีกเลย
# ⚠️ ห้ามเปลี่ยนค่านี้หลังมีข้อมูลแล้ว (ระบบจะไม่ยอมบันทึกอะไรเพิ่มจนกว่าจะใส่กุญแจเดิมกลับ — กันข้อมูลปนกุญแจสองดอก)
VAULT_KEY=

# ===== LINE Official Account (Messaging API) =====
# ไปที่ https://developers.line.biz/console/ -> สร้าง Provider + Messaging API Channel
# Channel secret / Channel access token อยู่ในแท็บ "Basic settings" / "Messaging API" ของ channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ===== LIFF (LINE Front-end Framework) =====
# สร้าง LIFF app ในหน้า channel เดียวกัน (แท็บ "LIFF") แล้วตั้ง Endpoint URL เป็น
#   https://<โดเมนจริงของแอป>/liff/new-ticket
# ขึ้นต้นด้วย NEXT_PUBLIC_ เพราะต้องถูกอ่านฝั่ง browser (จำเป็นตอน build ด้วย ไม่ใช่แค่ runtime)
NEXT_PUBLIC_LIFF_ID=

# ตอนยังไม่ได้สร้าง LIFF app จริง ปล่อยค่านี้ว่างไว้ได้ — ระบบจะ fallback เป็นฟอร์มให้กรอกชื่อเอง
# แทนการดึงจาก LINE Profile อัตโนมัติ (ดูรายละเอียดใน README.md หัวข้อ "การตั้งค่า LINE OA Bot")

# ===== Internal API (สำหรับ LINE Bot service ที่เขียนด้วย Python) =====
# shared secret ที่ bot ใช้ยิงเข้า /api/internal/* เพื่อสร้าง ticket และอ่านรายการสต็อก
# ต้องตั้งให้ตรงกับค่า INTERNAL_API_KEY ใน line-bot-python/.env
# สร้างด้วย: openssl rand -hex 32
INTERNAL_API_KEY=

# ===== แจ้งเตือนสถานะ ticket ทาง LINE =====
# สถานะที่จะ push หาผู้แจ้ง (คั่นด้วยจุลภาค) — เว้นว่างเพื่อปิดการแจ้งเตือนทั้งหมด
#
# ⚠️ แพ็กเกจฟรีของ LINE OA ส่ง push ได้ 300 ข้อความ/เดือน (ข้อความ reply ไม่นับ)
#    ค่าตั้งต้นส่งเฉพาะตอน "จบเรื่อง" = ~1 ข้อความต่อ 1 ticket รองรับ ~300 ticket/เดือน
#    ถ้าอยากให้แจ้งทุกครั้งที่เปลี่ยนสถานะ ใส่ครบทั้ง 7 ค่า แต่โควตาจะหมดเร็วขึ้น ~3 เท่า
#    ค่าที่ใส่ได้: pending, in_progress, waiting_info, waiting_delivery, resolved, completed, closed, cancelled
#    (completed = ทีม IT ปิดงาน → การ์ดแจ้งผลพร้อมดาวให้คะแนน 1–5 · resolved = ระบบเดิม รอผู้แจ้งยืนยัน)
#    หมายเหตุ: หน้าต่างอัปเดตสถานะในเว็บแอดมินส่งตามสวิตช์ "แจ้งกลับผ่าน LINE OA" ที่แอดมินเลือกเสมอ
LINE_NOTIFY_STATUSES=resolved,completed,closed,cancelled

# ===== แจ้งทีม IT เมื่อผู้แจ้งกดดูสถานะเรื่อง / กด "ยังมีปัญหาอยู่" =====
# LINE user id ของทีม IT ที่จะรับข้อความ "ผู้แจ้งเปิดดูสถานะแล้ว" และ "ผู้แจ้งแจ้งว่ายังมีปัญหาอยู่ — เปิดเรื่องกลับแล้ว"
# คั่นด้วยจุลภาค (สูงสุด 10 คน)
#
# หา user id ของตัวเอง: แอดด OA เป็นเพื่อน ทักไป 1 ข้อความ แล้วดู log ของบอท
#   docker compose logs bot | Select-String "user_id"
#
# ⚠️ ข้อความนี้ใช้โควตา push ก้อนเดียวกับการแจ้งสถานะ ticket (300 ข้อความ/เดือนบนแพ็กเกจฟรี)
#    ระบบจึงแจ้ง "เฉพาะครั้งแรกที่แต่ละคนเปิดดูแต่ละเรื่อง" ไม่ใช่ทุกครั้งที่กด
#    เพราะการกดซ้ำๆ ระหว่างรอคือพฤติกรรมปกติของคนที่รีบ — ครั้งต่อๆ ไปยังบันทึกลง log ครบ
#
# เว้นว่าง = ไม่ push เลย (ยังขึ้นในหน้าแอดมินตามปกติ) ซึ่งเป็นค่าตั้งต้นที่ตั้งใจ
LINE_ADMIN_USER_IDS=

# ===== เจ้าหน้าที่รับแชทต่อเอง (ปุ่ม "รับแชทต่อเอง" บน ticket) =====
# เว็บแอดมินสั่งบอทให้เงียบกับผู้แจ้งคนหนึ่ง ระหว่างที่เจ้าหน้าที่คุยเองในแอป LINE Official Account
# (LINE ไม่ส่ง webhook ตอนเจ้าหน้าที่ตอบแชท บอทจึงรู้เองไม่ได้) — ใช้ INTERNAL_API_KEY ตัวเดียวกับด้านบน
# ใน docker compose ตั้งให้แล้วเป็น http://bot:8000 · รันเว็บนอก compose (npm run dev) ใช้ http://127.0.0.1:8000
# เว้นว่าง = ปุ่มนี้ใช้ไม่ได้ (เว็บบอกว่ายังไม่ได้ตั้งค่า) ส่วนอย่างอื่นทำงานตามปกติ
LINE_BOT_INTERNAL_URL=

# ===== กันการเปิดเครื่องมือนักพัฒนา (Inspect / ดูซอร์สโค้ด) บนหน้าแอดมิน =====
#
# ⚠️ อ่านให้ครบก่อนพึ่งพาค่าพวกนี้:
#    กันได้แค่ "คนที่กดเล่นด้วยความอยากรู้" เท่านั้น กันคนที่ตั้งใจจะดูข้อมูลไม่ได้เลย
#    เพราะหน้าเว็บถูกส่งไปที่เครื่องผู้ใช้เรียบร้อยแล้วก่อนโค้ดกันจะได้ทำงาน
#    ทางที่ยังเปิดอยู่เสมอ: เปิด DevTools ก่อนเปิดเว็บ / เมนูเบราว์เซอร์ / ปิด JavaScript / curl
#    ชั้นป้องกันจริงมีอยู่ชั้นเดียวคือ AUTH_DISABLED=false (บังคับล็อกอิน)
#
# ตรวจว่าเปิดอยู่จริงไหม: curl.exe http://127.0.0.1:3000/api/health -> ดูก้อน "security"
# เปลี่ยนค่าแล้วแค่ `docker compose up -d app` พอ ไม่ต้อง --build (อ่านตอน request ไม่ใช่ตอน build)

# true = กัน F12 / Ctrl+Shift+I,J,C / Ctrl+U บนหน้าแอดมิน (ค่าตั้งต้น: true)
# ตั้ง false ชั่วคราวเวลาทีม IT ต้องเปิด DevTools ไล่ปัญหาหน้าเว็บจริงๆ
BLOCK_DEVTOOLS=true

# true = กันคลิกขวาทั้งหน้า (ยังคลิกขวาในช่องกรอกและบนข้อความที่เลือกไว้ได้ตามปกติ)
# นี่คือทางที่คนใช้เปิด Inspect บ่อยที่สุด และเป็นทางเดียวในชุดนี้ที่กันได้จริงทุกเบราว์เซอร์
BLOCK_CONTEXT_MENU=true

# true = เบลอหน้าจอเมื่อ "เดา" ว่า DevTools เปิดอยู่ (ค่าตั้งต้น: false)
# ปิดไว้เพราะเป็นการเดาจากขนาดหน้าต่าง ซึ่งพลาดได้ 2 ทาง:
#   ไม่เจอ: ถ้าผู้ใช้แยก DevTools เป็นหน้าต่างต่างหาก / เจอผิด: เวลาซูมแรงๆ หรือมีแถบเสริม
BLOCK_DEVTOOLS_DETECT=false

# คลังไฟล์ (/files): เพดานพื้นที่รวมของทุกไฟล์ หน่วย GB (ค่าตั้งต้น 20)
# อยู่ดิสก์เดียวกับข้อมูลทั้งระบบ — ถ้าคลังไฟล์กินจนดิสก์เต็ม การบันทึก ticket/สต็อกจะล้มไปด้วย
# นอกจากเพดานนี้ ระบบยังไม่รับไฟล์ที่รับแล้วดิสก์จะเหลือว่างไม่ถึง 2 GB
DRIVE_QUOTA_GB=20

# ทางเข้าจากอินเทอร์เน็ต: Cloudflare Tunnel (ตั้งแต่ 7 ต.ค. 2026 แทน Tailscale Funnel)
# ใส่ token ด้วย use-cloudflare.bat (วางแล้วไม่ขึ้นจอ) — อย่าพิมพ์ลงไฟล์นี้หรือส่งต่อในแชท
# token คือกุญแจของ tunnel ใครได้ไปก็ต่อเป็นเว็บนี้ได้ หลุดเมื่อไหร่ให้กด Rotate token ในหน้า Cloudflare
CLOUDFLARE_TUNNEL_TOKEN=
# ชื่อเว็บที่ตั้งไว้ใน Routes ของ tunnel — deploy.bat ใช้ตรวจจากข้างนอก
PUBLIC_HOST=it.thanakronpart-time.com

# ===== นำเข้าทะเบียนพนักงานจาก HR (หน้า /employees · 020) =====
# ไฟล์ = ทะเบียนล่าสุด: ไม่อยู่ในไฟล์ → สถานะ 0 (ปิดใช้งาน) ยกเว้นกลุ่มรหัสเหล่านี้ → คงสถานะเดิม
# กลุ่ม = ตัวอักษรนำหน้าทั้งหมด (AS12345 → AS ไม่ใช่ A) · ว่าง = ไฟล์คือรายชื่อทั้งหมด
EMPLOYEE_SYNC_KEEP_PREFIXES=AS,MS,PS
