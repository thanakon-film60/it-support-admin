# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ครบก่อนรัน `docker compose up -d`
#   cp .env.example .env
# (ตอนพัฒนาแบบ `npm run dev` บนเครื่องตัวเอง ใช้ชื่อ .env.local แทนได้ แต่ต้องเปลี่ยน host ใน
#  DATABASE_URL จาก "db" เป็น "localhost:5434" เพราะนอก compose network ไม่รู้จักชื่อ "db")

# ---- โดเมน ----
# โดเมนที่ Caddy จะออกใบรับรอง HTTPS ให้
DOMAIN=your-subdomain.duckdns.org
# ส่วนหน้า .duckdns.org ของโดเมนข้างบน — container duckdns ใช้อัปเดต IP สาธารณะให้อัตโนมัติ
DUCKDNS_SUBDOMAIN=your-subdomain
# token จากหน้า https://www.duckdns.org (ช่อง "token")
# ใช้ 2 อย่าง: อัปเดต IP ของโดเมน และให้ Caddy ขอใบรับรองแบบ DNS-01 (ไม่ต้องเปิด port 80 เข้ามา)
DUCKDNS_TOKEN=

# ---- ฐานข้อมูล ----
POSTGRES_USER=itadmin
POSTGRES_PASSWORD=เปลี่ยนเป็นรหัสผ่านที่สุ่มมา
POSTGRES_DB=itadmin
# host คือ "db" = ชื่อ service ใน docker-compose.yml ต้องตรงกับ POSTGRES_* ข้างบน
DATABASE_URL=postgresql://itadmin:เปลี่ยนเป็นรหัสผ่านที่สุ่มมา@db:5432/itadmin

# ---- แอป ----
# กุญแจเซ็น JWT ของ session แอดมิน — สุ่มด้วย:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ถ้าไม่ตั้ง แอปจะ fallback เป็นค่า insecure สำหรับ dev เท่านั้น ห้ามใช้บน production
SESSION_SECRET=

# ---- LINE Messaging API (ไม่บังคับ) ----
# ปล่อยว่างได้ หน้าแอดมินใช้งานได้ครบ แค่บอท LINE / LIFF จะยังไม่ทำงาน
# LINE Developers Console > channel > Basic settings
LINE_CHANNEL_SECRET=
# LINE Developers Console > channel > Messaging API > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=
# Channel ID ของ LINE Login channel ที่ใช้สร้าง LIFF (ไม่ใช่ Messaging API Channel ID)
# ฝั่ง server ใช้ค่านี้ตรวจ ID token ที่ LIFF ส่งมา
LINE_LOGIN_CHANNEL_ID=
# LIFF ID จากแท็บ LIFF ของ LINE Login channel — เป็น build-time env (ถูก inline เข้า client bundle)
# แก้ค่านี้แล้วต้อง `docker compose build app` ใหม่เสมอ แค่ restart ไม่พอ
NEXT_PUBLIC_LIFF_ID=
