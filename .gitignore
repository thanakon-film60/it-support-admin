# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# mock data store (สร้างอัตโนมัติตอนรันครั้งแรก — ดู src/lib/db/store.ts)
/data/

# ไฟล์ที่อัปโหลดเข้าคลังไฟล์ตอนรัน npm run dev (ใน docker อยู่ที่ volume "drive") — ห้ามขึ้น git เด็ดขาด
/drive/

# ไฟล์รูปที่อัปโหลดผ่านฟอร์ม FAQ (runtime only, ไม่ใช่ source)
/public/uploads/

# typescript
*.tsbuildinfo
next-env.d.ts

# Python LINE bot
line-bot-python/.venv/
line-bot-python/.env
__pycache__/
*.pyc
.pytest_cache/

# log ของ enable-funnel.ps1 -Unattended (รันทุกครั้งที่ล็อกอิน)
/logs/

# รหัสผ่านจริงของบริษัท (ไฟล์ CSV/Excel ต้นฉบับ) — ห้ามขึ้น git เด็ดขาด แม้ repo จะเป็น private
# git จำทุกอย่างที่เคย commit ตลอดไป ลบทีหลังก็ยังอยู่ในประวัติ ต้องเปลี่ยนรหัสผ่านทุกตัวอย่างเดียว
/Password-story/
